{
  "name": "dsh-session-namer",
  "version": "0.1.4",
  "description": "DSH web plugin: one-click \"summarize this session and rename it\" button in the session header.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
